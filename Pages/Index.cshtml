@page
@model THelp_Web.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col">
        <h1 class="h3 mb-0">Dashboard</h1>
        <p class="text-muted">Visão geral dos chamados e status do sistema.</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">Chamados abertos</h6>
                <h3 class="fw-bold">12</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">Em andamento</h6>
                <h3 class="fw-bold">5</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">Concluídos hoje</h6>
                <h3 class="fw-bold">3</h3>
            </div>
        </div>
    </div>
</div>
