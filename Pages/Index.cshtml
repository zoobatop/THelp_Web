@page
@model THelp_Web.Pages.IndexModel
@{
    // Esta página não será exibida, apenas redireciona
    ViewData["Title"] = "Redirecionando...";
}

<div class="text-center mt-5">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Redirecionando...</span>
    </div>
    <p class="mt-3">Redirecionando para a página inicial...</p>
</div>

@section Scripts {
    <script>
        // Redirecionamento via JavaScript também (backup)
        setTimeout(function() {
            window.location.href = '/Welcome';
        }, 1000);
    </script>
}