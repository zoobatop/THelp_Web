@page
@model THelp_Web.Pages.Organizacao.IndexModel
@{
    ViewData["Title"] = "Gerenciar Organizações";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#organizacaoModal">
            <i class="fas fa-plus"></i> Nova Organização
        </button>
    </div>

    @if (!string.IsNullOrEmpty(Model.Mensagem))
    {
        <div class="alert alert-@(Model.TipoMensagem == "success" ? "success" : "danger") alert-dismissible fade show" role="alert">
            @Model.Mensagem
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tabela -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>CNPJ</th>
                            <th>Email</th>
                            <th>Telefone</th>
                            <th>Ativo</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var organizacao in Model.Organizacoes)
                        {
                            <tr>
                                <td>@organizacao.IdOrganizacao</td>
                                <td>@organizacao.OrgNome</td>
                                <td>@organizacao.OrgCnpj</td>
                                <td>@organizacao.OrgEmail</td>
                                <td>@organizacao.OrgTelefone</td>
                                <td>
                                    <span class="badge bg-@(organizacao.OrgAtivo ? "success" : "danger")">
                                        @(organizacao.OrgAtivo ? "Sim" : "Não")
                                    </span>
                                </td>
                                <td>
                                    <form method="get" class="d-inline">
                                        <button type="submit" asp-page-handler="Edit" asp-route-id="@organizacao.IdOrganizacao" 
                                                class="btn btn-sm btn-warning" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                    </form>
                                    @if (organizacao.OrgAtivo)
                                    {
                                        <form method="post" class="d-inline">
                                            <button type="submit" asp-page-handler="Desativar" asp-route-id="@organizacao.IdOrganizacao"
                                                    class="btn btn-sm btn-secondary" title="Desativar"
                                                    onclick="return confirm('Tem certeza que deseja desativar esta organização?');">
                                                <i class="fas fa-pause"></i>
                                            </button>
                                        </form>
                                    }
                                    <form method="post" class="d-inline" 
                                          onsubmit="return confirm('Tem certeza que deseja excluir esta organização?');">
                                        <button type="submit" asp-page-handler="Delete" asp-route-id="@organizacao.IdOrganizacao"
                                                class="btn btn-sm btn-danger" title="Excluir">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="organizacaoModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@(Model.OrganizacaoEditId == 0 ? "Nova Organização" : "Editar Organização")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post">
                <input type="hidden" asp-for="OrganizacaoEditId" />
                
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="OrganizacaoInput.Nome" class="form-label">Nome *</label>
                                <input asp-for="OrganizacaoInput.Nome" class="form-control" />
                                <span asp-validation-for="OrganizacaoInput.Nome" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="OrganizacaoInput.Cnpj" class="form-label">CNPJ *</label>
                                <input asp-for="OrganizacaoInput.Cnpj" class="form-control" 
                                       placeholder="Apenas números"
                                       readonly="@(Model.OrganizacaoEditId > 0 ? "readonly" : null)" />
                                <span asp-validation-for="OrganizacaoInput.Cnpj" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="OrganizacaoInput.Email" class="form-label">Email</label>
                                <input asp-for="OrganizacaoInput.Email" type="email" class="form-control" />
                                <span asp-validation-for="OrganizacaoInput.Email" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="OrganizacaoInput.Telefone" class="form-label">Telefone</label>
                                <input asp-for="OrganizacaoInput.Telefone" class="form-control" />
                                <span asp-validation-for="OrganizacaoInput.Telefone" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3 form-check pt-4">
                                <input asp-for="OrganizacaoInput.Ativo" class="form-check-input" />
                                <label asp-for="OrganizacaoInput.Ativo" class="form-check-label">Organização Ativa</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    @if (Model.OrganizacaoEditId > 0)
                    {
                        <a asp-page-handler="CancelEdit" class="btn btn-secondary">Cancelar</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    }
                    <button type="submit" asp-page-handler="@(Model.OrganizacaoEditId == 0 ? "Create" : "Update")" 
                            class="btn btn-primary">
                        @(Model.OrganizacaoEditId == 0 ? "Criar" : "Atualizar")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        @if (Model.OrganizacaoEditId > 0)
        {
            <text>
            $(document).ready(function() {
                $('#organizacaoModal').modal('show');
            });
            </text>
        }

        $('#organizacaoModal').on('hidden.bs.modal', function () {
            if (@Model.OrganizacaoEditId > 0) {
                window.location.href = window.location.pathname;
            }
        });

        // Formatação do CNPJ
        $('#OrganizacaoInput_Cnpj').on('input', function() {
            var cnpj = $(this).val().replace(/\D/g, '');
            $(this).val(cnpj);
        });

        // Formatação do telefone
        $('#OrganizacaoInput_Telefone').on('input', function() {
            var telefone = $(this).val().replace(/\D/g, '');
            $(this).val(telefone);
        });
    </script>
}