@page
@model THelp_Web.Pages.RegisterModel

@{
    ViewData["Title"] = "Criar Conta";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="text-center">Criar Nova Conta</h3>
            </div>
            <div class="card-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label asp-for="Input.Nome" class="form-label">Nome Completo *</label>
                            <input asp-for="Input.Nome" class="form-control" placeholder="Digite seu nome completo" />
                            <span asp-validation-for="Input.Nome" class="text-danger"></span>
                        </div>
                        
                        <div class="col-md-12 mb-3">
                            <label asp-for="Input.Email" class="form-label">E-mail *</label>
                            <input asp-for="Input.Email" type="email" class="form-control" placeholder="exemplo@email.com" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Senha" class="form-label">Senha *</label>
                            <input asp-for="Input.Senha" type="password" class="form-control" placeholder="Mínimo 6 caracteres" />
                            <span asp-validation-for="Input.Senha" class="text-danger"></span>
                            <small class="form-text text-muted">
                                Deve conter: letra maiúscula, minúscula, número e caractere especial
                            </small>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.ConfirmarSenha" class="form-label">Confirmar Senha *</label>
                            <input asp-for="Input.ConfirmarSenha" type="password" class="form-control" placeholder="Repita a senha" />
                            <span asp-validation-for="Input.ConfirmarSenha" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">Criar Conta</button>
                        <a asp-page="/Login" class="btn btn-outline-secondary">Já tenho uma conta</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}