@page
@model THelp_Web.Pages.WelcomeModel

<div class="text-center">
    <h1 class="display-4 mb-4">Bem-vindo ao <span class="text-primary">THelp</span></h1>
    <p class="lead mb-5">Sistema de Help Desk para gerenciamento de chamados</p>
    
    <div class="row justify-content-center mt-5">
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-ticket-alt fa-3x text-primary mb-3"></i>
                    <h4 class="card-title">Abertura de Chamados</h4>
                    <p class="card-text">Abra chamados técnicos de forma rápida e organizada</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-comments fa-3x text-success mb-3"></i>
                    <h4 class="card-title">Chat em Tempo Real</h4>
                    <p class="card-text">Comunicação direta com o suporte técnico</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-chart-line fa-3x text-info mb-3"></i>
                    <h4 class="card-title">Acompanhamento</h4>
                    <p class="card-text">Acompanhe o status de seus chamados</p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <a asp-page="/Login" class="btn btn-primary btn-lg mx-2">
            <i class="fas fa-sign-in-alt"></i> Entrar
        </a>
        <a asp-page="/Register" class="btn btn-outline-primary btn-lg mx-2">
            <i class="fas fa-user-plus"></i> Cadastrar
        </a>
    </div>
</div>