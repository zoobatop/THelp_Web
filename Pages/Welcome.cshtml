@page
@model THelp_Web.Pages.WelcomeModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Bem-vindo";
}

<div class="text-center">
    <h1 class="h3 mb-3 fw-bold">Bem-vindo ao THelp</h1>
    <p class="text-muted mb-4">
        Sistema de chamados para organização e acompanhamento de solicitações.
    </p>

    <div class="d-grid gap-2">
        <a asp-page="/Login" class="btn btn-primary btn-lg">Entrar</a>
        <a asp-page="/Register" class="btn btn-outline-secondary">
            Criar uma nova conta
        </a>
    </div>

    <hr class="my-4" />
    <small class="text-muted">
        Ou retorne à página inicial do sistema:
        <a asp-page="/Index">Dashboard</a>
    </small>
</div>
