@page
@model THelp_Web.Pages.Papel.IndexModel
@{
    ViewData["Title"] = "Gerenciar Papéis";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#papelModal">
            <i class="fas fa-plus"></i> Novo Papel
        </button>
    </div>

    @if (!string.IsNullOrEmpty(Model.Mensagem))
    {
        <div class="alert alert-@(Model.TipoMensagem == "success" ? "success" : Model.TipoMensagem == "warning" ? "warning" : "danger") alert-dismissible fade show" role="alert">
            @Model.Mensagem
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Busca -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="post" class="row g-3">
                <div class="col-md-8">
                    <input asp-for="SearchTerm" class="form-control" placeholder="Buscar papéis por nome..." />
                </div>
                <div class="col-md-4">
                    <button type="submit" asp-page-handler="Search" class="btn btn-outline-primary me-2">
                        <i class="fas fa-search"></i> Buscar
                    </button>
                    <a asp-page="/Papel/Index" class="btn btn-outline-secondary">Limpar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabela -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Descrição</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var papel in Model.Papeis)
                        {
                            <tr>
                                <td>@papel.IdPapel</td>
                                <td>@papel.PapNome</td>
                                <td>@(papel.PapDescricao ?? "Sem descrição")</td>
                                <td>
                                    <form method="get" class="d-inline">
                                        <button type="submit" asp-page-handler="Edit" asp-route-id="@papel.IdPapel"
                                                class="btn btn-sm btn-warning" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                    </form>
                                    <form method="post" class="d-inline"
                                          onsubmit="return confirm('Tem certeza que deseja excluir este papel?');">
                                        <button type="submit" asp-page-handler="Delete" asp-route-id="@papel.IdPapel"
                                                class="btn btn-sm btn-danger" title="Excluir">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Papeis.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">
                                    Nenhum papel encontrado
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="papelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@(Model.PapelEditId == 0 ? "Novo Papel" : "Editar Papel")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post">
                <input type="hidden" asp-for="PapelEditId" />

                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="PapelInput.Nome" class="form-label">Nome *</label>
                        <input asp-for="PapelInput.Nome" class="form-control" />
                        <span asp-validation-for="PapelInput.Nome" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PapelInput.Descricao" class="form-label">Descrição</label>
                        <textarea asp-for="PapelInput.Descricao" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="PapelInput.Descricao" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    @if (Model.PapelEditId > 0)
                    {
                        <a asp-page-handler="CancelEdit" class="btn btn-secondary">Cancelar</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    }
                    <button type="submit" asp-page-handler="@(Model.PapelEditId == 0 ? "Create" : "Update")"
                            class="btn btn-primary">
                        @(Model.PapelEditId == 0 ? "Criar" : "Atualizar")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        @if (Model.PapelEditId > 0)
        {
                <text>
                $(document).ready(function() {
                    $('#papelModal').modal('show');
                });
                </text>
        }

        $('#papelModal').on('hidden.bs.modal', function () {
            if (@Model.PapelEditId > 0) {
                window.location.href = window.location.pathname;
            }
        });
    </script>
}