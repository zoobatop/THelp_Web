@using Microsoft.AspNetCore.Mvc.RazorPages
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - THelp</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/_Layout.css" /> @* vamos criar esse *@

    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="topbar navbar navbar-dark bg-primary">
        <div class="container-fluid">
            <button class="btn btn-outline-light d-md-none me-2" id="sidebarToggle">
                ☰
            </button>

            <a class="navbar-brand fw-bold" asp-page="/Index">
                THelp - Sistema de Chamados
            </a>

            <div class="d-flex align-items-center">
                <span class="text-white me-3">
                    @* Exemplo, depois você pode colocar o usuário logado *@
                    Olá, Usuário
                </span>
                <a class="btn btn-outline-light btn-sm" asp-page="/Login">Sair</a>
            </div>
        </div>
    </header>

    <div class="app-container d-flex">
        <nav id="sidebar" class="sidebar bg-dark text-white">
            <div class="sidebar-header p-3 border-bottom border-secondary">
                <h5 class="mb-0">Menu</h5>
            </div>

            <ul class="nav flex-column p-2">
                <li class="nav-item">
                    <a class="nav-link text-white" asp-page="/Index">
                        🏠 Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-page="/Welcome">
                        👋 Tela de Boas-vindas
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-page="/Test/Connection">
                        🧪 Testar API
                    </a>
                </li>

                @* Depois você adiciona outras páginas do sistema de chamados aqui *@
                <li class="nav-item mt-3">
                    <span class="text-secondary small px-3 text-uppercase">Chamados</span>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white-50 disabled" href="#">
                        (exemplo) Meus Chamados
                    </a>
                </li>
            </ul>
        </nav>

        <main class="main-content flex-grow-1">
            <div class="container-fluid py-4">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
