@page
@model THelp_Web.Pages.Test.ConnectionModel

@{
    ViewData["Title"] = "Teste de Conexão";
}

<div class="container mt-4">
    <h2>Teste de Conexão com a API</h2>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Status da Conexão</h5>

            <div class="row">
                <div class="col-md-6">
                    <p><strong>URL da API:</strong> @Model.ApiStatus.BaseUrl</p>
                    <p>
                        <strong>Status:</strong>
                        <span class="badge @(Model.ConnectionResult.IsSuccess ? "bg-success" : "bg-danger")">
                            @(Model.ConnectionResult.IsSuccess ? "Online" : "Offline")
                        </span>
                    </p>
                </div>
                <div class="col-md-6">
                    <p>
                        <strong>Tempo de Resposta:</strong>
                        @(Model.ConnectionResult.ResponseTimeMs >= 0 ? $"{Model.ConnectionResult.ResponseTimeMs} ms" : "N/A")
                    </p>
                    <p><strong>Último Teste:</strong> @Model.ApiStatus.LastChecked.ToString("dd/MM/yyyy HH:mm:ss")</p>
                </div>
            </div>

            <p><strong>Mensagem:</strong> @Model.ConnectionResult.Message</p>

            <div class="mt-3">
                <button id="testBtn" class="btn btn-primary">Testar Novamente</button>
                <a href="/" class="btn btn-secondary">Voltar</a>
            </div>

            <div id="statusResult" class="mt-3"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('testBtn').addEventListener('click', async function() {
            const btn = this;
            const originalText = btn.textContent;
            const statusResult = document.getElementById('statusResult');

            btn.disabled = true;
            btn.textContent = 'Testando...';
            statusResult.innerHTML = '<div class="alert alert-info">Testando conexão...</div>';

            try {
                const response = await fetch('?handler=CheckStatus', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });

                const result = await response.json();

                if (result.success) {
                    statusResult.innerHTML = '<div class="alert alert-success">' + result.message + '</div>';
                    // Recarrega a página após 1 segundo
                    setTimeout(() => location.reload(), 1000);
                } else {
                    statusResult.innerHTML = '<div class="alert alert-danger">' + result.message + '</div>';
                }
            } catch (error) {
                statusResult.innerHTML = '<div class="alert alert-danger">Erro ao testar conexão: ' + error.message + '</div>';
            } finally {
                btn.disabled = false;
                btn.textContent = originalText;
            }
        });
    </script>
}